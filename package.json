{
  "name": "tentacrawl",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Generic web scraping platform with DSL-driven browser automation",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "node scripts/dev.mjs --no-deps",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "dev:deps": "docker compose up -d",
    "dev:deps:down": "docker compose down",
    "dev:deps:logs": "docker compose logs -f",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev:api": "node scripts/dev.mjs --no-deps --service=api",
    "dev:worker": "node scripts/dev.mjs --no-deps --service=worker",
    "dev:web": "node scripts/dev.mjs --no-deps --service=web",
    "build:web": "pnpm --filter @tentacrawl/web run build",
    "docker:up": "docker compose -f docker-compose.fullapp.yml up --build -d",
    "docker:down": "docker compose -f docker-compose.fullapp.yml down",
    "docker:logs": "docker compose -f docker-compose.fullapp.yml logs -f",
    "docker:ps": "docker compose -f docker-compose.fullapp.yml ps",
    "sandbox": "pnpm --filter @tentacrawl/browser run sandbox",
    "generate": "pnpm --filter @tentacrawl/cli run generate"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript-eslint": "^8.59.2"
  }
}
